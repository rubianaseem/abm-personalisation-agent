# Optional. Without it the agent runs fully offline on templates.
# Export it in your shell (the agent reads the environment only; it does not load .env files).
ANTHROPIC_API_KEY=
# Optional model override
ANTHROPIC_MODEL=claude-sonnet-4-5
# Salt for pseudonymising contact emails in trace.jsonl. Set your own secret value for real data.
ABM_TRACE_SALT=
# Not used: this repo has no live HubSpot, LinkedIn, Clay or enrichment client. See SETUP.md for the CSV exports it reads.
